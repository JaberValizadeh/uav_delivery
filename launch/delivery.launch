<?xml version="1.0"?>
<!--
  delivery.launch
  ===============
  Three hector quadrotors collect and deliver parcels around a depot yard.

    Global:
      1. Gazebo + worlds/depot_yard.world (which loads the link attacher)
      2. dispatcher - owns every parcel, assigns each to exactly one courier

    Per drone (namespaces uav_0, uav_1, uav_2), from one_uav.launch:
      3. the airframe, its plugins and controller/twist
      4. pose_delivery_monitor - logs pose, job and board state
      5. courier - takeoff, fly, descend, grasp, carry, descend, release

  Each box is delivered by exactly one drone. That is enforced by the
  dispatcher rather than by the couriers negotiating: a parcel carries the
  namespace it was assigned to, the assignment is made once while the parcel is
  on the ground and the drone is empty, and it is held until the box is
  confirmed down at its destination. Nothing retasks a loaded aircraft, because
  halfway through a job the drone is holding the thing and no other aircraft
  can take over.

  Usage:
    source ~/uav_ws/src/uav_pick_place/setup_uav.bash
    roslaunch uav_delivery delivery.launch
    roslaunch uav_delivery delivery.launch gui:=false num_parcels:=7
    roslaunch uav_delivery delivery.launch rviz:=true

  Topics:
    /delivery/parcels                  the whole board
    /delivery/markers                  RViz: depot names and parcel routes
    /delivery/report                   couriers reporting grasp/release
    /uav_0/delivery/task               uav_0's job
    /uav_0/cmd_vel                     body-frame velocity command
    /uav_0/scan                        Hokuyo on the mast
    /link_attacher_node/attach         the gripper, shared by all three
-->
<launch>

  <arg name="gui"      default="true" />
  <arg name="headless" default="false" />

  <arg name="rviz"        default="false" />
  <arg name="rviz_config" default="$(find uav_delivery)/rviz/delivery.rviz" />

  <!-- Generated by scripts/make_city, together with the obstacle list below.
       worlds/depot_yard.world is the older walled yard with eight crate stacks
       and is still here if a bare test arena is wanted. -->
  <arg name="world" default="$(find uav_delivery)/worlds/city_block.world" />

  <!-- Parcels in the system at once. More than the fleet size on purpose: with
       three of each, the greedy assignment degenerates into a fixed pairing
       and a drone that finishes early has nothing to pick up. -->
  <arg name="num_parcels" default="5" />

  <!-- The warehouse: the single place every parcel starts from. The apron is
       drawn at WAREHOUSE in scripts/make_city, so this and the marking come
       from the same constant; change it in both or boxes spawn onto blank
       ground beside the paint. -->
  <arg name="warehouse" default="['WH', -12.5, -12.5]" />

  <!-- How far across the apron boxes may be laid out. Wider than it needs to
       be for the boxes alone: a courier will not descend while another is
       within depot_guard_xy (1.3 m) of its goal, so parcels closer together
       than that turn the hub into a single-file queue. Spread over 3.6 m,
       two aircraft can work different bays at once. -->
  <arg name="apron_half" default="1.1" />
  <arg name="min_parcel_gap" default="1.00" />

  <!-- The customer area. Addresses are drawn at random anywhere inside
       customer_half, except within customer_min_from_warehouse of the hub -
       that exclusion is what makes every job a real transit rather than a
       hop off the apron. With the warehouse in the corner it also means the
       aircraft cross most of the yard on every delivery and come back empty. -->
  <arg name="customer_half" default="12.0" />
  <arg name="customer_min_from_warehouse" default="9.0" />
  <!-- Keep two outstanding addresses apart, or the second courier queues
       behind the first at the same doorstep for no reason. -->
  <arg name="customer_gap" default="3.0" />
  <arg name="yard_half"  default="16.0" />
  <arg name="grid_cell"  default="3.2" />
  <arg name="delivered_dwell" default="3.0" />
  <!-- A beat with no address at all, between one order clearing and the next
       being drawn. Without it the marker is moved in the same tick it is
       cleared, which reads as it sliding across the yard rather than as one
       delivery finishing and a new order starting somewhere else. -->
  <arg name="address_blank"   default="0.8" />

  <!-- Where the buildings are, so the dispatcher can tell whether a dropped
       parcel is somewhere a courier could actually collect it.

       This used to be a hand-typed list under a comment saying "keep in step
       with the world - nothing checks". It is now loaded from the file
       scripts/make_city writes in the same pass as the world itself, so a
       building cannot exist in Gazebo without the dispatcher knowing not to
       deliver into it. Regenerate both together:

         rosrun uav_delivery make_city  seed 7

       A box that comes to rest against a building is inside the laser's stop
       distance, so an aircraft descending onto it gets backed off and yawed at
       0.8 m and tips over. Measured on the crates this replaced: a parcel
       dropped 0.67 m from the south-west stack cost three rescues in ninety
       seconds, the same drone each time, because assignment is nearest-first
       and the drone that just dropped it is always the nearest. Such a parcel
       is recovered to the warehouse instead. -->
  <arg name="obstacles_file"
       default="$(find uav_delivery)/config/city_obstacles.yaml" />

  <!-- Measures how close the aircraft actually get to the buildings and trees,
       against the exact collision geometry make_city writes alongside the
       world. On by default: it only subscribes, and "the drones avoid
       obstacles" is otherwise a claim nothing in this package checks. -->
  <arg name="clearance" default="true" />
  <arg name="geometry_file"
       default="$(find uav_delivery)/config/city_geometry.yaml" />
  <arg name="retrieve_clearance" default="1.6" />


  <!-- Box geometry and mass. The mass is the tightest constraint in the
       package and it is NOT a lift limit - thrust caps at 30 N against a
       14.5 N airframe, so there is about 1.5 kg spare and none of it usable.
       A box welded on at runtime never reaches the controller, which read the
       airframe's inertia once at startup, so it adds m*d^2 of roll and pitch
       inertia that the attitude loop cannot see. At 0.04 kg and 0.26 m below
       base_link that is 23% of the airframe's own; at 0.15 kg it was 142% and
       the drone held a sustained +-3 degree roll limit cycle that never
       decayed. See the note at the top of urdf/quadrotor_courier.gazebo.xacro. -->
  <arg name="box_size" default="0.10" />
  <arg name="box_mass" default="0.04" />

  <!-- How far below base_link the grasp pad hangs. MUST match grasp_reach in
       urdf/quadrotor_courier.gazebo.xacro. -->
  <arg name="grasp_reach" default="0.21" />

  <!-- How close to the destination a box has to come to rest to count. Half a
       depot pad, so a box on the marking is delivered and a box beside it is
       not; anything outside goes back on the board with its source updated to
       wherever it actually landed. -->
  <arg name="deliver_radius" default="0.45" />

  <!-- Transit altitude for the *lowest* layer. Clears the 0.10 m boxes with a
       box hanging 0.31 m below the airframe, and stays well under the 3 m
       crates so the drones have to go round them rather than over. -->
  <arg name="cruise_altitude" default="1.2" />

  <!-- Structural deconfliction: each courier transits on its own layer, so
       uav_0 cruises at 1.2, uav_1 at 1.9, uav_2 at 2.6. An aircraft occupies
       about 0.56 m vertically - mast top at +0.25, a slung box at -0.31 - so
       a 0.7 m layer gap leaves about 0.14 m between two transiting aircraft
       and most of a run is transit. The top layer plus its mast reaches
       2.85 m, which is why the crates in the world are 3 m: a layer that
       cleared the obstacle field would be a layer whose drone never used its
       laser. -->
  <arg name="cruise_layer_gap" default="0.7" />

  <!-- Reactive deconfliction, for everything the layers do not cover - chiefly
       the depots, where all three layers collapse onto the same descent.
       Inside both of these distances the aircraft without right of way stops
       and holds. Loaded has right of way over empty; ties go to the lower
       namespace.

       separation_z MUST stay below cruise_layer_gap, and getting that backwards
       is not a subtle failure. At 0.9 against a 0.6 gap, two aircraft on
       adjacent layers were "in conflict" every time one passed over the other -
       correctly separated by design and yielding to each other anyway. The
       layers stopped doing anything and the fleet spent the run stopping. -->
  <arg name="separation_xy" default="1.5" />
  <arg name="separation_z"  default="0.50" />
  <arg name="yield_speed"   default="0.5" />

  <!-- Descent serialisation. A courier will not drop into a depot while
       another aircraft is already down in it, and queues on its own layer
       instead - the layers separate transits completely and then all of them
       meet at the descent, which is where the conflicts actually were. -->
  <arg name="depot_guard_xy" default="1.3" />
  <arg name="depot_guard_z"  default="0.7" />
  <!-- Faster than the old yard needed. A spoke here is 9 to 35 m rather than
       3 to 9, so transit dominates a job now and 1.1 m/s turned most of a run
       into commuting. -->
  <arg name="linear_speed"    default="1.7" />
  <arg name="angular_gain"    default="2.0" />

  <!-- Switch from flying to station-keeping inside this. Wider than the grasp
       tolerance by a lot, so the aircraft is already stopped and holding
       position by the time precision starts to matter. -->
  <arg name="arrive_radius" default="0.60" />

  <!-- Avoidance, and the one coupling that decides both numbers.

       avoid_dist MUST NOT exceed retrieve_clearance (1.6 m). Addresses are
       drawn at least retrieve_clearance from every building and tree, so an
       avoid_dist above it would put the doorstep itself inside the avoidance
       zone: the courier would slow and yaw away from the very point it is
       trying to hold over, and the approach would never converge. That is why
       the answer to "get further from the buildings" is not this number.

       stop_dist is where the headroom is. At 0.9 the closest approach measured
       over a full run was 0.47 m against a 0.35 m rotor radius - no contact,
       but 0.12 m of margin, which a gust or a heavier box would eat. Reversing
       0.2 m earlier costs nothing: it is well inside avoid_dist, so it does not
       change when avoidance starts, only how hard it finishes. Re-measured with
       clearance_monitor after the change. -->
  <arg name="avoid_dist" default="1.6" />
  <arg name="stop_dist"  default="1.1" />

  <!-- ============================== Gazebo ============================== -->
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name"   value="$(arg world)" />
    <arg name="gui"          value="$(arg gui)" />
    <arg name="headless"     value="$(arg headless)" />
    <arg name="paused"       value="false" />
    <arg name="use_sim_time" value="true" />
    <arg name="debug"        value="false" />
  </include>

  <!-- ============================ the couriers ==========================
       Parked around the warehouse, which is where an empty aircraft belongs:
       2.9 to 3.4 m off the apron so no parcel spawns underneath one, at least
       3.4 m from each other, and clear of the shed. They cannot sit on the
       apron itself - a drone parked there is a drone with a box appearing
       under it. -->

  <group ns="uav_0">
    <include file="$(find uav_delivery)/launch/one_uav.launch">
      <arg name="ns" value="uav_0" />
      <arg name="x"  value="-14.5" />
      <arg name="y"  value="-10.5" />
      <arg name="cruise_altitude" value="$(arg cruise_altitude)" />
      <arg name="linear_speed"    value="$(arg linear_speed)" />
      <arg name="angular_gain"    value="$(arg angular_gain)" />
      <arg name="avoid_dist"      value="$(arg avoid_dist)" />
      <arg name="stop_dist"       value="$(arg stop_dist)" />
      <arg name="arrive_radius"   value="$(arg arrive_radius)" />
      <arg name="grasp_reach"     value="$(arg grasp_reach)" />
      <arg name="box_size"        value="$(arg box_size)" />
      <arg name="fleet"           value="[uav_0, uav_1, uav_2]" />
      <arg name="separation_xy"   value="$(arg separation_xy)" />
      <arg name="separation_z"    value="$(arg separation_z)" />
      <arg name="yield_speed"     value="$(arg yield_speed)" />
      <arg name="depot_guard_xy"  value="$(arg depot_guard_xy)" />
      <arg name="depot_guard_z"   value="$(arg depot_guard_z)" />
    </include>
  </group>

  <group ns="uav_1">
    <include file="$(find uav_delivery)/launch/one_uav.launch">
      <arg name="ns" value="uav_1" />
      <arg name="x"  value="-10.5" />
      <arg name="y"  value="-14.5" />
      <arg name="cruise_altitude" value="$(eval arg('cruise_altitude') + arg('cruise_layer_gap'))" />
      <arg name="linear_speed"    value="$(arg linear_speed)" />
      <arg name="angular_gain"    value="$(arg angular_gain)" />
      <arg name="avoid_dist"      value="$(arg avoid_dist)" />
      <arg name="stop_dist"       value="$(arg stop_dist)" />
      <arg name="arrive_radius"   value="$(arg arrive_radius)" />
      <arg name="grasp_reach"     value="$(arg grasp_reach)" />
      <arg name="box_size"        value="$(arg box_size)" />
      <arg name="fleet"           value="[uav_0, uav_1, uav_2]" />
      <arg name="separation_xy"   value="$(arg separation_xy)" />
      <arg name="separation_z"    value="$(arg separation_z)" />
      <arg name="yield_speed"     value="$(arg yield_speed)" />
      <arg name="depot_guard_xy"  value="$(arg depot_guard_xy)" />
      <arg name="depot_guard_z"   value="$(arg depot_guard_z)" />
    </include>
  </group>

  <group ns="uav_2">
    <include file="$(find uav_delivery)/launch/one_uav.launch">
      <arg name="ns" value="uav_2" />
      <arg name="x"  value="-10.9" />
      <arg name="y"  value="-10.9" />
      <arg name="cruise_altitude" value="$(eval arg('cruise_altitude') + 2 * arg('cruise_layer_gap'))" />
      <arg name="linear_speed"    value="$(arg linear_speed)" />
      <arg name="angular_gain"    value="$(arg angular_gain)" />
      <arg name="avoid_dist"      value="$(arg avoid_dist)" />
      <arg name="stop_dist"       value="$(arg stop_dist)" />
      <arg name="arrive_radius"   value="$(arg arrive_radius)" />
      <arg name="grasp_reach"     value="$(arg grasp_reach)" />
      <arg name="box_size"        value="$(arg box_size)" />
      <arg name="fleet"           value="[uav_0, uav_1, uav_2]" />
      <arg name="separation_xy"   value="$(arg separation_xy)" />
      <arg name="separation_z"    value="$(arg separation_z)" />
      <arg name="yield_speed"     value="$(arg yield_speed)" />
      <arg name="depot_guard_xy"  value="$(arg depot_guard_xy)" />
      <arg name="depot_guard_z"   value="$(arg depot_guard_z)" />
    </include>
  </group>

  <!-- ============================ the parcel book =======================
       One node, no namespace. Held back until Gazebo has the world and all
       three models loaded: it spawns the boxes itself and assigns by drone
       position, so starting it into a half-built simulator only produces
       timeouts to read. -->
  <node pkg="uav_delivery" type="dispatcher" name="dispatcher"
        output="screen"
        launch-prefix="bash -c 'sleep 12 &amp;&amp; exec &quot;$0&quot; &quot;$@&quot;' --">
    <rosparam param="drones">[uav_0, uav_1, uav_2]</rosparam>
    <param name="num_parcels"    value="$(arg num_parcels)" />
    <param name="box_size"       value="$(arg box_size)" />
    <param name="box_mass"       value="$(arg box_mass)" />
    <param name="deliver_radius" value="$(arg deliver_radius)" />
    <rosparam param="warehouse" subst_value="true">$(arg warehouse)</rosparam>
    <param name="apron_half"     value="$(arg apron_half)" />
    <!-- How far apart boxes are laid out on the apron. Was 0.30 when every
         parcel had its own depot and this only had to stop two boxes being
         spawned inside each other; now they all share one source it also sets
         how many couriers can load at once. Below depot_guard_xy (1.3 m) the
         hub is a single-file queue by construction. -->
    <param name="min_parcel_gap" value="$(arg min_parcel_gap)" />
    <!-- Loads the generated `obstacles:` list into this node's private
         namespace, so it arrives as ~obstacles exactly as the inline version
         did - the dispatcher is unchanged and does not know where it came
         from. -->
    <rosparam file="$(arg obstacles_file)" command="load" />
    <param name="retrieve_clearance" value="$(arg retrieve_clearance)" />
    <param name="customer_half" value="$(arg customer_half)" />
    <param name="customer_min_from_warehouse"
           value="$(arg customer_min_from_warehouse)" />
    <param name="customer_gap"  value="$(arg customer_gap)" />
    <param name="yard_half"     value="$(arg yard_half)" />
    <param name="grid_cell"     value="$(arg grid_cell)" />
    <!-- How long a delivered parcel is left sitting on the customer's
         doorstep before the slot is reused. Without it the box teleports back
         to the warehouse the instant delivery is confirmed - while the courier
         that just placed it is still climbing off the address - so the one
         moment worth watching is the one moment you cannot see. -->
    <param name="delivered_dwell" value="$(arg delivered_dwell)" />
    <param name="address_blank"   value="$(arg address_blank)" />
    <!-- A box centre below this is resting on the ground rather than in
         transit. Comfortably above half a box (0.05) and well below the
         0.31 m the aircraft releases from. -->
    <param name="grounded_z"     value="0.12" />
    <param name="publish_hz"     value="10.0" />
  </node>

  <node if="$(arg clearance)" pkg="uav_delivery" type="clearance_monitor"
        name="clearance_monitor" output="screen">
    <param name="geometry_file" value="$(arg geometry_file)" />
    <param name="rotor_radius"  value="0.35" />
    <param name="near_miss"     value="0.55" />
    <rosparam param="namespaces">[uav_0, uav_1, uav_2]</rosparam>
  </node>

  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
        args="-d $(arg rviz_config)" output="screen"
        launch-prefix="bash -c 'sleep 12 &amp;&amp; exec &quot;$0&quot; &quot;$@&quot;' --" />

</launch>
