<?xml version="1.0"?>
<!-- GENERATED by scripts/make_city (seed 3). Do not edit by hand:
     config/city_obstacles.yaml is written from the same loop and the
     two have to agree. Change the city by editing make_city and
     running it again.

     A 32 x 32 m city block grid: 24 buildings on a 9.0 m street
     pitch with 5.4 m carriageways, one park, and the delivery depot
     in the south-west corner. Buildings are 4 to 12 m tall, so no
     cruise layer (1.2, 1.9, 2.6 m) can climb over one - every aircraft
     has to use its laser, which was also true of the crates this
     replaced.

     Only the buildings and the boundary wall have collision. Roads,
     kerbs, markings, crossings and the park are flat visuals, so
     nothing that makes this look like a city can stop a drone or trap
     a released parcel.

     The link attacher plugin below is the drones gripper and must
     stay: it serves /link_attacher_node/attach and /detach. -->
<sdf version="1.6">
  <world name="default">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <plugin name="ros_link_attacher_plugin" filename="libgazebo_ros_link_attacher.so" />

    <scene>
      <ambient>0.65 0.65 0.65 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <shadows>false</shadows>
    </scene>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

