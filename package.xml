<?xml version="1.0"?>
<package format="2">
  <name>uav_delivery</name>
  <version>0.1.0</version>
  <description>
    Three hector quadrotors collect and deliver parcels around a walled depot
    yard in Gazebo. Boxes appear at random named depots, each with a random
    destination depot; a single dispatcher assigns every box to exactly one
    aircraft and holds that assignment until the box is confirmed on the ground
    at its address. Couriers transit at cruise altitude with reactive laser
    avoidance, descend onto the box, weld it on with gazebo_ros_link_attacher,
    carry it across the yard and set it down. Delivery is judged by where the
    box actually is, not by what the drone believes.
  </description>

  <maintainer email="valizadeh.au@gmail.com">Jaber Valizadeh</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf</depend>
  <depend>gazebo_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- The gripper: a world plugin serving /link_attacher_node/attach and
       /detach, which weld two links with a fixed joint. Source-built sibling
       in this workspace, and gzserver only finds the .so if
       GAZEBO_PLUGIN_PATH includes ~/uav_ws/devel/lib - source
       uav_pick_place/setup_uav.bash. -->
  <exec_depend>gazebo_ros_link_attacher</exec_depend>

  <!-- The airframe, its Gazebo plugins, its twist controller and the Hokuyo
       description. Source-built siblings in this workspace. -->
  <exec_depend>hector_quadrotor_description</exec_depend>
  <exec_depend>hector_quadrotor_gazebo</exec_depend>
  <exec_depend>hector_quadrotor_controller</exec_depend>
  <exec_depend>hector_quadrotor_model</exec_depend>
  <exec_depend>hector_sensors_description</exec_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- Only for rviz:=true; the yard runs without it. -->
  <exec_depend>rviz</exec_depend>

  <export></export>
</package>
